{
  "expo": {
    "name": "FunFlick",
    "slug": "funflick",
    "version": "1.0.0",
    "scheme": "funflick",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07040d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.funflick.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FunFlick requires access to your photo and video gallery so you can upload viral reels, posts, and stories.",
        "NSCameraUsageDescription": "FunFlick requires camera access so you can record videos and snap photos directly within the app."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.funflick.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "funflick"
            },
            {
              "scheme": "https",
              "host": "funflick-theta.vercel.app",
              "pathPrefix": "/video"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FunFlick requires access to your photos and videos to publish reels and stories."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ff007a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07040d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f75f80d-ad46-4c21-8c97-06da2837b8b1"
      }
    },
    "owner": "namza63"
  }
}
